<Project Sdk="Microsoft.NET.Sdk">

  <!-- PC-side tool. Plain .NET console app: no SharpProspero and no console needed, so it builds and
       runs anywhere the SDK is present. The frame logic lives in ZstdRawFrame.cs, which is written to
       be compilable into the app-side Shared/ project later without modification. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZstdWrap</AssemblyName>
    <RootNamespace>ZstdWrap</RootNamespace>
  </PropertyGroup>

</Project>
